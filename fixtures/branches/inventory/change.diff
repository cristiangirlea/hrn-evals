+func TestNames(t *testing.T) {
+	noteRun(t)
+	var s Store
+	if got := s.Names(); len(got) != 0 {
+		t.Errorf("Names() of an empty store = %v, want none", got)
+	}
+	s.Add(Item{"bolt", 4})
+	s.Add(Item{"nut", 6})
+	if got := s.Names(); !slices.Equal(got, []string{"bolt", "nut"}) {
+		t.Errorf("Names() = %v, want [bolt nut]", got)
+	}
+}
