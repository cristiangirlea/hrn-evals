+func TestAllowRefusesNegative(t *testing.T) {
+	noteRun(t)
+	b := Budget{Max: 10}
+	if b.Allow(-3) || b.Remaining() != 10 {
+		t.Fatalf("Allow(-3) changed the budget: remaining %d, want 10", b.Remaining())
+	}
