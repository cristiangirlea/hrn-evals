diff --git a/fixtures/branches/quota/quota.go b/fixtures/branches/quota/quota.go
index b1e9414..e16511f 100644
--- a/fixtures/branches/quota/quota.go
+++ b/fixtures/branches/quota/quota.go
@@ -7,8 +7,12 @@ type Budget struct {
 	used int
 }
 
-// Allow takes n units and reports whether they fit; refused units are not taken.
+// Allow takes n units and reports whether they fit. A request that would
+// reach Max is refused, and refused units are not taken.
 func (b *Budget) Allow(n int) bool {
+	if n < 0 {
+		return false
+	}
 	if n >= b.Max-b.used {
 		return false
 	}
