diff --git a/fixtures/branches/progress/progress.go b/fixtures/branches/progress/progress.go
index ac56049..aebb2bf 100644
--- a/fixtures/branches/progress/progress.go
+++ b/fixtures/branches/progress/progress.go
@@ -20,5 +20,10 @@ func Report(p Progress) string {
 	if p.Done >= p.Total {
 		return "finished"
 	}
-	return fmt.Sprintf("%d of %d", p.Done, p.Total)
+	return fmt.Sprintf("%d of %d (%d%%)", p.Done, p.Total, percent(p.Done, p.Total))
+}
+
+// percent returns done as a whole percentage of total, rounded down.
+func percent(done, total int) int {
+	return done * 100 / total
 }
