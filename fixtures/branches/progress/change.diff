+
+func TestPercent(t *testing.T) {
+	noteRun(t)
+	for _, c := range []struct{ done, total, want int }{
+		{1, 4, 25},
+		{1, 3, 33},
+		{999, 1000, 99},
+	} {
+		if got := percent(c.done, c.total); got != c.want {
+			t.Errorf("percent(%d, %d) = %d, want %d", c.done, c.total, got, c.want)
+		}
+	}
