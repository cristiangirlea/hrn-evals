{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(bash -n scripts/run-all.sh)",
      "Bash(hrn eval list *)",
      "Bash(hrn eval list)",
      "Bash(hrn eval show *)",
      "Bash(hrn eval diff *)",
      "Bash(hrn runs)",
      "Bash(hrn runs -n *)",
      "Bash(hrn show *)",
      "Bash(hrn backends)",
      "Bash(hrn version)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git blame *)",
      "Bash(git branch *)",
      "Bash(git worktree list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(hrn batch merge *)",
      "Bash(hrn runs prune *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)"
    ]
  }
}
